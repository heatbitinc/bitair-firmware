# Bitair firmware: settings that differ from the ESP-IDF and component defaults.
# Everything not listed here uses its Kconfig default. Regenerate the minimal
# set with `idf.py save-defconfig` and keep the grouping and comments below.
# Backend endpoints live in sdkconfig.defaults.heatbit, production security
# settings in sdkconfig.defaults.security.

# Chip, flash and partitions
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Bootloader
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# CPU, PSRAM and FreeRTOS
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Logging: off in release builds (can be enabled at runtime over the backend)
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_COLORS=y

# Wi-Fi and BLE (station only, NimBLE for provisioning)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_DEBUG_PRINT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Network and TLS
CONFIG_LWIP_MAX_SOCKETS=26
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# Mining (upstream options; board defaults override voltage and frequency at boot)
CONFIG_ASIC_VOLTAGE=1400
CONFIG_ASIC_FREQUENCY=250

# Frequency ramp: 25 MHz steps every 50 ms (upstream: 6.25 MHz every 100 ms).
# 50 -> 600 MHz takes 1.2 s instead of 9.2 s; tested on Bitair with no TPS546 warnings.
CONFIG_ASIC_FREQ_RAMP_STEP_MULT=4
CONFIG_ASIC_FREQ_RAMP_STEP_DELAY_MS=50
